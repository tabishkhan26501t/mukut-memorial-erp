# Frontend environment variables (Vite — must be prefixed with VITE_)
# For local dev with Vite proxy, leave empty (uses /api proxy to localhost:5000)
# For split deployment (Vercel frontend -> Render backend), set to your backend URL:
# VITE_API_URL=https://mukut-memorial-demo.onrender.com
VITE_API_URL=

# Set to "true" to show DEMO MODE banner and demo credentials hint on login
# This is safe to expose — it only controls UI chrome.
VITE_DEMO_MODE=false
