# — Demo / deployment —
# Set to "true" to enable demo mode (ephemeral uploads, visible DEMO badge, demo reset endpoint)
DEMO_MODE="false"
# Secret token required for POST /api/demo/reset — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DEMO_RESET_TOKEN=""
# Optional: override API URL for split frontend/backend deployment (Vercel frontend -> Render backend)
# VITE_API_URL is set in the *frontend* environment (client/.env) as e.g. https://your-backend.onrender.com
# VITE_DEMO_MODE="true" in client env shows the frontend demo banner
